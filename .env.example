# Copy to .env and fill in your Supabase project values.
# Client-side (inlined into the browser bundle at build time by Vite):
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Server-side (used by SSR and server functions):
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-or-anon-key"
SUPABASE_PROJECT_ID="YOUR-PROJECT"

# Server-only admin key — bypasses RLS. NEVER expose to the client.
# REQUIRED: the reservation server function (src/lib/reservations.functions.ts)
# writes through this client, so bookings fail with a 500 if it is unset.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Reservation confirmation emails (optional). Without RESEND_API_KEY the booking
# still saves, but no guest/admin email is sent — the server just logs a warning.
RESEND_API_KEY=""
RESTAURANT_EMAIL="bookings@your-domain.com"

# Public site URL used for absolute links in /sitemap.xml (optional).
# Defaults to the origin of the incoming request.
SITE_URL="https://your-domain.com"
